        "## Punto 3. Benchmark de algoritmos\n",
        "Se comparan seis enfoques: K-Means, jerárquico Ward, BIRCH, mezcla gaussiana, DBSCAN y OPTICS. Son métodos de partición/distancia, modelos probabilísticos y densidad. Los parámetros de densidad son una configuración inicial reproducible, no una optimización exhaustiva."
      ],
      "metadata": {
        "id": "AdE5dE75lcQf"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "models={\n",
        " 'K-Means':lambda:KMeans(n_clusters=2,n_init=15,random_state=42),\n",
        " 'Jerárquico Ward':lambda:AgglomerativeClustering(n_clusters=2,linkage='ward'),\n",
        " 'BIRCH':lambda:Birch(n_clusters=2,threshold=.6),\n",
        " 'Mezcla gaussiana':lambda:GaussianMixture(n_components=2,n_init=3,random_state=42),\n",
        " 'DBSCAN':lambda:DBSCAN(eps=1.1,min_samples=8),\n",
        " 'OPTICS':lambda:OPTICS(min_samples=12,xi=.05,min_cluster_size=.05),\n",
        "}\n",
        "def benchmark(matrix, etiqueta):\n",
        " rows=[]; labels={}\n",
        " for name,build in models.items():\n",
        "  m=build(); lab=m.fit_predict(matrix) if name!='Mezcla gaussiana' else m.fit(matrix).predict(matrix)\n",
        "  labels[name]=lab; mask=(lab!=-1); ncl=len(set(lab[mask])); cov=mask.mean()\n",
        "  record={'Experimento':etiqueta,'Modelo':name,'Clusters':ncl,'Ruido':int((~mask).sum()),'Cobertura':cov,\n",
        "   'Silhouette':np.nan,'Davies-Bouldin':np.nan,'Calinski-Harabasz':np.nan,\n",
        "   'ARI':adjusted_rand_score(y,lab),'NMI':normalized_mutual_info_score(y,lab)}\n",
        "  if ncl>1 and mask.sum()>ncl:\n",
        "   record['Silhouette']=silhouette_score(matrix[mask],lab[mask])\n",
        "   record['Davies-Bouldin']=davies_bouldin_score(matrix[mask],lab[mask])\n",
        "   record['Calinski-Harabasz']=calinski_harabasz_score(matrix[mask],lab[mask])\n",
        "  rows.append(record)\n",
        " return pd.DataFrame(rows),labels\n",
        "r0,l0=benchmark(Z,'Sin PCA');r1,l1=benchmark(Z_pca,'Con PCA')\n",
        "results=pd.concat([r0,r1],ignore_index=True)\n",
        "display(results.round(3))\n",
        "results.to_csv('Unidad3_resultados_benchmark.csv',index=False)"
      ],
