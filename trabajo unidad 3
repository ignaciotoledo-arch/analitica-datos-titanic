        "y=df['Survived'].to_numpy() # SOLO evaluación externa\n",
        "X=df[['Pclass','Sex','Age','SibSp','Parch','Fare','Embarked','Cabin']].copy()\n",
        "X['HasCabin']=X['Cabin'].notna().astype(int)\n",
        "X.drop(columns='Cabin',inplace=True)\n",
        "q1,q3=df.Fare.quantile([.25,.75]); upper=q3+1.5*(q3-q1)\n",
