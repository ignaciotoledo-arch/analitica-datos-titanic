        " ('categoricas',Pipeline([('moda',SimpleImputer(strategy='most_frequent')),('ohe',OneHotEncoder(handle_unknown='ignore',sparse_output=False))]),cat)\n",
        "],sparse_threshold=0)\n",
        "Z=pre.fit_transform(X)\n",
        "print('Matriz preparada:',Z.shape,'Límite superior Fare:',round(upper,2))"
