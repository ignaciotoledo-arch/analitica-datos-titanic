        "curve=np.cumsum(PCA().fit(Z).explained_variance_ratio_)\n",
        "plt.figure(figsize=(8,4));plt.plot(range(1,len(curve)+1),curve,marker='o');plt.axhline(.9,ls='--',label='90 %');plt.axvline(Z_pca.shape[1],ls=':',label='Componentes elegidas');plt.xlabel('N.º componentes');plt.ylabel('Varianza explicada acumulada');plt.legend();plt.show()\n"
